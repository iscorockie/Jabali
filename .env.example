# ==============================================================================
# JABALI TRAILS AFRICA — ENVIRONMENT VARIABLES (.env.example)
# Copy this file to `.env.local` for local development or configure in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STRIPE PAYMENT GATEWAY (Required for live/test Stripe API calls)
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Note: When running locally without keys configured, the app automatically
# enables an interactive Stripe Test Mode Sandbox so the full booking + payment
# + webhook flow can be tested end-to-end out of the box.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key

# Stripe Webhook Secret for verifying `checkout.session.completed` and
# `payment_intent.succeeded` events at `/api/webhooks/stripe`
# Local CLI: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# Optional pre-created Stripe Price IDs (if omitted, dynamic `price_data` is used)
STRIPE_PRICE_BWINDI_GORILLA_5D=price_sample_bwindi_5d
STRIPE_PRICE_PRIMATE_KINGDOM_8D=price_sample_primate_8d
STRIPE_PRICE_GREAT_RIFT_NILE_7D=price_sample_rift_7d
STRIPE_PRICE_KIDEPO_WALKING_6D=price_sample_kidepo_6d
STRIPE_PRICE_PEARL_CIRCUIT_12D=price_sample_pearl_12d
STRIPE_PRICE_EAST_AFRICA_10D=price_sample_eastafrica_10d

# ------------------------------------------------------------------------------
# 2. APPLICATION URL CONFIGURATION
# Used for Stripe Checkout `success_url` and `cancel_url` redirects when
# request Origin header is not present.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. OPTIONAL THIRD-PARTY SAFARI INVENTORY / PERMIT BRIDGES (Future-Ready)
# Used when connecting live Uganda Wildlife Authority (UWA) E-Permit portal or
# third-party reservation systems (Checkfront / Rezdy / FareHarbor).
# ------------------------------------------------------------------------------
UWA_PERMIT_PORTAL_MODE=simulated
NEXT_PUBLIC_BOOKING_ENGINE_PROVIDER=jabali-native-stripe
